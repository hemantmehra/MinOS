fn main() {
    print("P1: starting\n");

    let child_process_id = create_process("P2.EXE");
    if (child_process_id > 0) {
        print("P1: waiting for P2\n");
        let wait_result = wait_process(child_process_id);
        if (wait_result == 1) {
            print("P1: P2 completed\n");
        } else {
            print("P1: could not wait for P2\n");
        }
    } else {
        print("P1: could not start P2\n");
    }

    print("P1: exiting\n");
}
