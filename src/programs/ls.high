fn main() {
    array path[128];
    array name[256];
    let argument_length = read_arguments(path);
    let directory = -1;
    let result = 0;
    let index = 0;

    if (argument_length < 0) {
        print("ls: path argument is too long.\n");
        return;
    }

    directory = opendir(path);
    if (directory < 0) {
        print("ls: could not open directory.\n");
        return;
    }

    result = read_dir(directory, name);
    while (result > 0) {
        if (name[0] != 46) {
            index = 0;
            while (name[index] != 0) {
                print_char(name[index]);
                index = index + 1;
            }
            print("  ");
        }
        result = read_dir(directory, name);
    }

    closedir(directory);
    if (result < 0) {
        print("ls: could not read directory.\n");
    } else {
        print("\n");
    }
}
