fn main() {
    array path[128];
    let length = get_current_directory(path);
    let index = 0;

    if (length < 0) {
        print("pwd: could not read current directory.\n");
        return;
    }

    while (index < length) {
        print_char(path[index]);
        index = index + 1;
    }
    print("\n");
}
