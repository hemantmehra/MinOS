fn main() {
    let number = read_number("Enter n (0-12): ", 2);

    if (number > 12) {
        print("Input out of range; use 0-12.\n");
    } else {
        let result = 1;
        let factor = 2;
        while (factor <= number) {
            result = result * factor;
            factor = factor + 1;
        }

        print("n! = ");
        print_num(number);
        print(" = ");
        print_num(result);
        print("\n");
    }
}
