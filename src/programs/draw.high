fn main() {
    let radius = 140;
    let radius_squared = radius * radius;
    let x = 0 - radius;
    let y = 0 - radius;
    let distance = 0;

    start_graphics_mode();
    while (y <= radius) {
        x = 0 - radius;
        while (x <= radius) {
            distance = x * x + y * y;
            if (distance <= radius_squared &&
                distance >= radius_squared - radius * 2) {
                pixel(640 + x, 360 + y, 12);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    present();

    while (key() != 1) {
    }
    end_graphics_mode();
}
