fn main() {
    array arguments[128];
    array contents[256];
    let argument_length = read_arguments(arguments);
    let index = 0;
    let content_length = 0;
    let handle = -1;
    let result = -1;

    if (argument_length < 0) {
        print("Usage: write B:/file <text>\n");
        return;
    }

    while (arguments[index] != 0 && arguments[index] != 32) {
        index = index + 1;
    }
    if (arguments[index] == 0) {
        print("Usage: write B:/file <text>\n");
        return;
    }
    arguments[index] = 0;
    index = index + 1;
    while (arguments[index] == 32) {
        index = index + 1;
    }

    while (arguments[index] != 0 && content_length < 256) {
        contents[content_length] = arguments[index];
        content_length = content_length + 1;
        index = index + 1;
    }
    if (arguments[index] != 0) {
        print("write: text is limited to 256 bytes.\n");
        return;
    }

    handle = open_file(arguments);
    if (handle < 0) {
        print("write: could not open file. Use an existing B: file.\n");
        return;
    }
    result = truncate_file(handle);
    if (result < 0) {
        close_file(handle);
        print("write: writing is supported only on B: files.\n");
        return;
    }
    result = write_file(handle, contents, content_length);
    close_file(handle);

    if (result < 0) {
        print("write: disk write failed or file capacity was exceeded.\n");
    } else {
        print("Wrote ");
        print_num(result);
        print(" bytes.\n");
    }
}
