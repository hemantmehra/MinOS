fn main() {
    array buffer[256];
    let count = 0;
    let index = 0;
    let character = 0;
    let in_word = 0;
    let words = 0;
    let finished = 0;

    while (finished == 0) {
        count = read_stream(STD_INPUT_HANDLE, buffer);
        if (count < 0) {
            finished = 1;
        } else if (count == 0) {
        } else {
            index = 0;
            while (index < count) {
                character = buffer[index];
                if (character == 32 || character == 9 ||
                    character == 10 || character == 13) {
                    in_word = 0;
                } else {
                    if (in_word == 0) {
                        words = words + 1;
                        in_word = 1;
                    }
                }
                index = index + 1;
            }
        }
    }

    print_num(words);
    print("\n");
}
