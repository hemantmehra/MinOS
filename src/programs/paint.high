fn main() {
    let window = create_window("Paint", 640, 480);
    if (window == 0) {
        print("paint: could not create graphics window.\n");
        return;
    }

    start_graphics_mode();
    clear(15);
    draw_circle(130, 240, 80, 12);
    draw_triangle();
    draw_rectangle();
    present();

    while (key() != 1) {
    }
    end_graphics_mode();
}

fn draw_circle(center_x, center_y, radius, color) {
    let y = 0 - radius;
    let distance = 0;
    while (y <= radius) {
        let x = 0 - radius;
        while (x <= radius) {
            distance = x * x + y * y;
            if (distance <= radius * radius) {
                if (distance >= radius * radius - radius * 2) {
                    pixel(center_x + x, center_y + y, color);
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
}

fn draw_triangle() {
    let y = 80;
    while (y <= 380) {
        let half_width = (y - 80) / 2;
        let x = 320 - half_width;
        let right = 320 + half_width;
        while (x <= right) {
            pixel(x, y, 10);
            x = x + 1;
        }
        y = y + 1;
    }
}

fn draw_rectangle() {
    let y = 130;
    while (y <= 370) {
        let x = 465;
        while (x <= 600) {
            pixel(x, y, 9);
            x = x + 1;
        }
        y = y + 1;
    }
}
